{
  "id": "com.gorihei.startup-plugin",
  "name": "スタートアップ管理",
  "version": "0.2.0",
  "apiVersion": "1",
  "entry": "target/debug/startup-plugin.exe",
  "description": "Windows起動時に自動実行されるプログラムを一覧・無効化します",
  "author": "gorihei",
  "trust": "local-dev",
  "permissions": ["system:read", "system:write"],
  "autoStart": true,
  "contributes": {
    "widgets": [],
    "commands": [
      {
        "id": "startup.list",
        "method": "list",
        "title": "スタートアップ: 一覧取得",
        "description": "レジストリRunキーとスタートアップフォルダから自動起動項目を集めて返します",
        "riskLevel": 0,
        "requiresPermission": "system:read"
      },
      {
        "id": "startup.disable",
        "method": "disable",
        "title": "スタートアップ: 無効化",
        "description": "自動起動項目を削除します(paramsに{\"source\": \"...\", \"name\": \"...\", \"value\": \"...\"}が必要)。元に戻せません",
        "riskLevel": 2,
        "requiresPermission": "system:write"
      }
    ],
    "pages": [
      {
        "id": "startup.main",
        "title": "スタートアップ管理",
        "entry": "ui/index.html"
      }
    ],
    "searchProviders": [],
    "automation": {}
  }
}
